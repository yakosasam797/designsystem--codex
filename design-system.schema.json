{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "version", "themeModes", "entrypoint", "source", "foundations", "components"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "themeModes": { "type": "array", "items": { "type": "string" } },
    "entrypoint": { "type": "string" },
    "source": { "type": "object", "required": ["name", "type"] },
    "foundations": { "type": "object" },
    "components": { "type": "object", "required": ["metadata", "implementation", "styles", "stories", "public"] }
  }
}
