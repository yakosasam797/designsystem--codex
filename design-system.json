{
  "$schema": "./design-system.schema.json",
  "name": "ParyatechOS",
  "version": "1.0.0",
  "themeModes": ["light", "dark"],
  "entrypoint": "src/index.ts",
  "source": {
    "name": "Paryatech Design System.dc.html + PRD Figma colour variables",
    "type": "approved-design-system-sources"
  },
  "foundations": {
    "tokens": "src/tokens/colors.css",
    "metadata": "src/tokens/tokenMetadata.ts",
    "stories": "src/foundations/Foundations.stories.tsx",
    "fonts": ["Onest", "Public Sans", "JetBrains Mono"]
  },
  "components": {
    "metadata": "src/components/componentMetadata.ts",
    "implementation": "src/components/components.tsx",
    "styles": "src/components/components.css",
    "stories": [
      "src/components/Primitives.stories.tsx",
      "src/components/FormsNavigation.stories.tsx",
      "src/components/DataDisplay.stories.tsx",
      "src/components/Overlays.stories.tsx"
    ],
    "public": [
      "Button", "IconButton", "StatusBadge", "KindBadge", "CountBadge", "ReadinessChip", "Avatar",
      "Input", "Select", "SearchField", "Checkbox", "SegmentedControl", "Tabs", "Breadcrumbs", "Pagination",
      "Toolbar", "DataTable", "SummaryPanel", "EmptyState", "LoadingState", "Modal", "Menu", "PriceCell",
      "RateCardTable", "DataPair"
    ]
  }
}
